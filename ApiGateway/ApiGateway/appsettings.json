{
  "Jwt": {
    "Key": "super-secret-key-that-never-be-found-out-in-this-life",
    "Issuer": "auth-service",
    "Audience": "ecommerce"
  },

  "Services": {
    "Auth": "http://auth:8080",
    "Catalog": "http://catalog:8080",
    "Payments": "http://payments:8080",
    "Orders": "http://orders:8080",
    "Inventory": "http://inventory:8080",
    "Graphrag": "http://graphrag-api:8100",
    "PdfWOrker": "http://pdf-worker:8080",
    "Notifications": "http://notifications-api:8200"
  },

  "Cors": {
    "AllowedOrigins":[
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },

  "ReverseProxy": {
    "Routes": {
      // Administrative routes: refused early for anyone who is not an Admin. Services enforce the same rule themselves.
      "auth-admin": {
        "ClusterId": "auth-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/auth/admin/{**catch-all}"
        }
      },

      "products-admin": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/admin/{**catch-all}"
        }
      },

      "inventory-admin": {
        "ClusterId": "inventory-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/inventory/admin/{**catch-all}"
        }
      },

      "orders-admin": {
        "ClusterId": "orders-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/orders/admin/{**catch-all}"
        }
      },

      "payments-admin": {
        "ClusterId": "payments-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/payments/admin/{**catch-all}"
        }
      },

      "orders-list": {
        "ClusterId": "orders-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/orders",
          "Methods": [ "GET" ]
        }
      },

      "payments-list": {
        "ClusterId": "payments-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/payments",
          "Methods": [ "GET" ]
        }
      },

      "payments-refund": {
        "ClusterId": "payments-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/payments/{id}/refund",
          "Methods": [ "POST" ]
        }
      },

      "inventory-list": {
        "ClusterId": "inventory-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/inventory",
          "Methods": [ "GET" ]
        }
      },

      "inventory-adjust": {
        "ClusterId": "inventory-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/inventory/{productId}/adjustments",
          "Methods": [ "POST" ]
        }
      },

      "inventory-movements": {
        "ClusterId": "inventory-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/inventory/{productId}/movements",
          "Methods": [ "GET" ]
        }
      },

      "inventory-threshold": {
        "ClusterId": "inventory-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/inventory/{productId}/threshold",
          "Methods": [ "PUT" ]
        }
      },

      "catalog-product-create": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products",
          "Methods": [ "POST" ]
        }
      },

      "catalog-product-write": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}",
          "Methods": [ "PUT", "DELETE" ]
        }
      },

      "catalog-product-image-upload": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/images",
          "Methods": [ "POST" ]
        }
      },

      "catalog-product-image-delete": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/images/{imageId}",
          "Methods": [ "DELETE" ]
        }
      },

      "catalog-product-status": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/status",
          "Methods": [ "POST" ]
        }
      },

      "catalog-product-image-primary": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/images/{imageId}/primary",
          "Methods": [ "POST" ]
        }
      },

      "catalog-product-image-order": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/images/order",
          "Methods": [ "PUT" ]
        }
      },

      "catalog-product-model-write": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        // 3D models may be up to 100 MB (plus multipart overhead); every other route keeps the default body limit.
        "MaxRequestBodySize": 105906176,
        "Match": {
          "Path": "/products/{id}/model",
          "Methods": [ "PUT", "DELETE" ]
        }
      },

      "catalog-product-attribute-add": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/attributes",
          "Methods": [ "POST" ]
        }
      },

      "catalog-product-attribute-delete": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/attributes/{attributeId}",
          "Methods": [ "DELETE" ]
        }
      },

      "catalog-product-relation-add": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/relations",
          "Methods": [ "POST" ]
        }
      },

      "catalog-product-relation-delete": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/products/{id}/relations/{relationId}",
          "Methods": [ "DELETE" ]
        }
      },

      "catalog-brands-write": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/brands/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },

      "catalog-filament-types-write": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/filament-types/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },

      "catalog-categories-write": {
        "ClusterId": "catalog-cluster",
        "Order": -1,
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/categories/{**catch-all}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        }
      },

      "auth-public": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "catalog-products": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        }
      },

      "catalog-brands": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/brands/{**catch-all}"
        }
      },

      "catalog-filament-types": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/filament-types/{**catch-all}"
        }
      },

      "catalog-categories": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/categories/{**catch-all}"
        }
      },

      "payments": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },

      "orders": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },

      "inventory": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        }
      },

      "pdf-worker-documents": {
        "ClusterId": "pdf-worker-cluster",
        "Match": {
          "Path": "/documents/{**catch-all}"
        }
      },

      "graphrag-search": {
        "ClusterId": "graphrag-cluster",
        "Match": {
          "Path": "/graphrag/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/graphrag" }
        ]
      },

      "notifications": {
        "ClusterId": "notifications-cluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth:8080"
          }
        }
      },

      "catalog-cluster": {
        "Destinations": {
          "catalog": {
            "Address": "http://catalog:8080"
          }
        }
      },

      "payments-cluster": {
        "Destinations": {
          "payments": {
            "Address": "http://payments:8080"
          }
        }
      },

      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://orders:8080"
          }
        }
      },

      "inventory-cluster": {
        "Destinations": {
          "inventory": {
            "Address": "http://inventory:8080"
          }
        }
      },

      "pdf-worker-cluster": {
        "Destinations": {
          "inventory": {
            "Address": "http://pdf-worker:8080"
          }
        }
      },

      "graphrag-cluster": {
        "Destinations": {
          "graphrag": {
            "Address": "http://graphrag-api:8100"
          }
        }
      },

      "notifications-cluster": {
        "Destinations": {
          "notifications": {
            "Address": "http://notifications-api:8200"
          }
        }
      }
    }
  },

  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4317"
}